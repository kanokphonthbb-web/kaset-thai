// CMS สำหรับเขียนบทความหลังบ้าน (โครงคล้าย linli)
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Article[]
}

model Article {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  excerpt          String    @default("")
  content          String    @default("") // compiled HTML (public rendering)
  blocksJson       String    @default("[]") // block editor source (for re-editing)
  format           String    @default("blocks") // "blocks" | "html"
  rawHtml          String    @default("") // ต้นฉบับ HTML เมื่อ format = html
  articleType      String    @default("howto") // qa | general | howto | deep (ช่วงความยาว)
  coverImage       String    @default("") // Unsplash photo id หรือ URL
  seoTitle         String    @default("")
  metaDescription  String    @default("")
  focusKeyword     String    @default("")
  faqJson          String    @default("[]") // [{q,a}] -> FAQPage schema + <details>
  phase            String    @default("") // Phase 1/2/3 (จาก content map)
  priority         String    @default("") // P1/P2/P3
  subcategory      String    @default("") // หมวดย่อยจาก content map
  brief            String    @default("") // JSON brief (angle/mustInclude/sources/links/instruction)
  categoryId       String?
  status           String    @default("draft") // draft | published
  publishedAt      DateTime?
  contentUpdatedAt DateTime? // เวลาที่เนื้อหา/SEO สาธารณะเปลี่ยนจริง (ไม่รวม backfill ข้อมูลระบบ)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  articleNo    Int?   @unique // เลขบทความจาก content-map-10000 (source workbook "No.") — join key สำหรับ affiliate-v2 assignment
  productsJson String @default("[]") // JSON string[] ของ Product.shopeeId เรียงตาม rank (สูงสุด 4) จาก affiliate-v2 mapping

  category ArticleCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([categoryId])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  imageUrl      String
  affiliateLink String
  category      String   @default("") // ArticleCategory slug, best-guess classification
  keywords      String   @default("[]") // JSON string[] — all source keywords mapped to this product
  whyNeeded     String   @default("") // เหตุผลที่ต้องใช้
  benefits      String   @default("[]") // JSON string[] — ประโยชน์ (bullet points)
  usage         String   @default("") // ใช้เพื่ออะไร / ใช้งานอย่างไร
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shopeeId            String?   @unique // affiliate-v2 catalog product id — canonical stable import key
  status              String    @default("active") // active | held (regulated/high-risk, excluded from all public surfaces)
  howToChoose         String    @default("") // วิธีเลือก/ตรวจก่อนสั่งซื้อ
  useCasesJson        String    @default("[]") // JSON string[] — core_topics จาก catalog
  safetyNote          String    @default("")
  priceLabel          String    @default("") // ราคาดิบจาก catalog ณ วันที่ตรวจสอบ (อาจว่าง/ไม่ใช่ตัวเลข)
  priceCheckedAt      DateTime?
  relatedArticlesJson String    @default("[]") // JSON string[] ของ Article.slug ที่ลิงก์สินค้านี้ (reverse index, สูงสุด 6)

  @@index([category])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// NABC Agricultural Data Engine — cache tables for prices / production / livestock
// จาก NABC API (https://api.nabc.oae.go.th) ปัจจุบัน API ยังเข้าถึงไม่ได้ (DNS ไม่ resolve)
// ดู docs/api-notes/NABC_API_NOTES.md — ห้าม fabricate ข้อมูลราคา, ตารางเหล่านี้จะว่างจนกว่าจะ sync ได้จริง
// ─────────────────────────────────────────────────────────────

model AgriProduct {
  id              String   @id @default(cuid())
  sourceProductId String   @unique
  source          String   @default("nabc")
  nameTh          String
  category        String
  unit            String?
  slug            String?  @unique
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  priceSnapshots AgriPriceSnapshot[]

  @@index([category])
}

model AgriMarket {
  id             String   @id @default(cuid())
  sourceMarketId String   @unique
  name           String
  province       String?
  marketType     String?
  createdAt      DateTime @default(now())

  priceSnapshots AgriPriceSnapshot[]
}

model AgriPriceSnapshot {
  id         String   @id @default(cuid())
  productId  String
  marketId   String?
  priceType  String // "farm-gate" | "wholesale" | "retail"
  priceMin   Float?
  priceMax   Float?
  priceAvg   Float?
  unit       String?
  sourceDate DateTime
  fetchedAt  DateTime
  source     String   @default("nabc")

  product AgriProduct @relation(fields: [productId], references: [id])
  market  AgriMarket? @relation(fields: [marketId], references: [id])

  @@unique([productId, marketId, priceType, sourceDate])
  @@index([productId, sourceDate])
}

model CropProduction {
  id               String    @id @default(cuid())
  cropSourceId     String
  cropName         String
  year             Int
  provinceId       String
  provinceName     String
  plantedAreaRai   Float?
  harvestedAreaRai Float?
  productionTon    Float?
  yieldPerRaiKg    Float?
  source           String    @default("nabc")
  sourceDate       DateTime?
  fetchedAt        DateTime

  @@unique([cropSourceId, year, provinceId])
  @@index([cropName, year])
}

model LivestockCensus {
  id            String    @id @default(cuid())
  year          Int
  provinceId    String
  provinceName  String
  districtName  String?
  livestockType String
  farmerCount   Int?
  animalCount   Int?
  source        String    @default("nabc")
  sourceDate    DateTime?
  fetchedAt     DateTime

  @@unique([year, provinceId, districtName, livestockType])
  @@index([livestockType, year])
}

model DataSyncRun {
  id           String    @id @default(cuid())
  source       String
  endpoint     String
  startedAt    DateTime
  completedAt  DateTime?
  status       String // "running" | "success" | "error"
  rowsReceived Int       @default(0)
  rowsInserted Int       @default(0)
  rowsUpdated  Int       @default(0)
  error        String?
}
